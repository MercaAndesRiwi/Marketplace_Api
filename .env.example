# App Config
APP_ENV=dev
APP_NAME=Marketplace_Api

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Fault injection
FAULT_OUT_OF_ORDER_RATE=0.0
FAULT_LATE_ARRIVAL_RATE=0.0
FAULT_DUPLICATE_RATE=0.0

# Output
OUTPUT_FILE=data/raw/events.jsonl

# Kafka configuration (for future streaming in data_platform)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDERS=mercaandes.orders.events
KAFKA_PRODUCER_TIMEOUT_SECONDS=10
