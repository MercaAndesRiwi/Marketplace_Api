# Runtime environment
APP_ENV=development

# Marketplace API (F4)
API_HOST=0.0.0.0
API_PORT=8000

# Marketplace events configuration
MASTER_SEED=42
F4_DUPLICATE_RATE=0.0
F4_OOO_ENABLED=false
F4_OOO_MAX_LAG_SEC=21600

# Output file (JSONL - for compatibility and local development)
OUTPUT_FILE=data/raw/events.jsonl

# Kafka configuration (for future streaming in data_platform)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=marketplace.events
KAFKA_ENABLED=false

# Valid authentication tokens (comma-separated)
VALID_TOKENS=token-seller-123,bearer-token-mercaandes-2026,test-token
